# ========================================================
# Environment Configuration for Review Sentiment Pipeline
# ========================================================

# Supabase / PostgreSQL Credentials
# Get this from Supabase Dashboard > Project Settings > Database
DATABASE_URL=postgresql://postgres.your_project_id:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Hugging Face Access Token
# Get free read token from: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_token_here

# Groq API Key (Free tier Llama 3.1)
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Slack Incoming Webhook URL
# Create at https://api.slack.com/apps > Incoming Webhooks
SLACK_WEBHOOK_URL=https://your-slack-webhook-url-here
